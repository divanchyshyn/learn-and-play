# Local development only. Copy to `api/.env` (gitignored) or export these in your
# shell before `cargo run --manifest-path api/Cargo.toml`. Nothing here is a real
# secret; the deployed values live in Secret Manager and Worker secrets.

# The local Postgres from docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learn_and_play?sslmode=disable

# Any long random string. Sign-up and sign-in only work when it is set.
PEPPER=dev-pepper-not-used-anywhere-real

# Every state-changing request must carry this Origin. Match the page you are
# testing from: http://localhost:8787 for `wrangler dev`, or
# http://localhost:8080 if you call the API directly.
PUBLIC_ORIGIN=http://localhost:8787

# Optional. When set, every request must also carry the matching X-Door-Secret.
# Leave it empty unless you are also setting API_DOOR_SECRET in .dev.vars.
DOOR_SECRET=
