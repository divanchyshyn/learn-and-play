{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash",
  "small_model": "openrouter/deepseek/deepseek-v4.1-flash",
  "enabled_providers": ["openrouter"],
  "instructions": ["AGENTS.md"],
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "description": "Implements one GitHub issue for the Learn and Play games library.",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "edit": "allow",
        "bash": {
          "*": "deny",
          "npm ci": "allow",
          "npm run lint": "allow",
          "npm run test*": "allow",
          "npm run build": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git add*": "allow",
          "git commit*": "allow"
        },
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny"
      }
    }
  }
}
